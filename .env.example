# Environment variables for RateFlow Docker setup
# Copy this file to .env and modify as needed

# Application Settings
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rateflow
SPRING_DATASOURCE_USERNAME=rateflow_user
SPRING_DATASOURCE_PASSWORD=rateflow_pass

# Redis Configuration
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# Kafka Configuration
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_KAFKA_PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
SPRING_KAFKA_PRODUCER_VALUE_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
SPRING_KAFKA_CONSUMER_KEY_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
SPRING_KAFKA_CONSUMER_VALUE_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
SPRING_KAFKA_CONSUMER_GROUP_ID=rateflow-group
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest

# JWT Configuration (if using authentication)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_MS=86400000

# Rate Limiting Configuration
RATE_LIMIT_BUCKET_CAPACITY=100
RATE_LIMIT_REFILL_RATE=10
RATE_LIMIT_REFILL_PERIOD_MS=1000

# Notification Settings
NOTIFICATION_ENABLED=true
NOTIFICATION_KAFKA_TOPIC=notification-events
NOTIFICATION_DLQ_TOPIC=notification-events-dlq

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN
LOGGING_LEVEL_COM_EXAMPLE_DEMO=DEBUG